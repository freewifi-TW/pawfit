# Compose 層級的環境變數（複製為 .env）
# Laravel 自己的設定在 apps/api/.env，Nuxt 的在 compose.yaml 的 web.environment

APP_PORT=8080
APP_URL=http://localhost:8080

# 正式環境才需要
SITE_DOMAIN=

# Postgres（開發用預設值；正式環境務必更換）
DB_DATABASE=pawfit
DB_USERNAME=pawfit
DB_PASSWORD=pawfit
DB_PORT_HOST=54329

# 物件儲存：開發＝MinIO；正式＝Cloudflare R2
R2_ACCESS_KEY_ID=pawfit
R2_SECRET_ACCESS_KEY=pawfitpawfit
R2_BUCKET=pawfit-media
R2_BACKUP_BUCKET=pawfit-backup

# Grafana（http://localhost:3001；開發環境免登入，正式環境需要密碼，見 docs/logging.md）
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=

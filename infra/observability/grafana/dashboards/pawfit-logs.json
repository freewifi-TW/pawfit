{
  "uid": "pawfit-logs",
  "title": "Pawfit · Logs",
  "tags": ["pawfit", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "service", "type": 1 },
        "definition": "label_values(service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": ["$__all"] },
        "sort": 1
      },
      {
        "name": "level",
        "label": "level",
        "type": "custom",
        "query": "debug,info,warning,error,critical",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": ["$__all"] },
        "options": [
          { "text": "All", "value": "$__all", "selected": true },
          { "text": "debug", "value": "debug", "selected": false },
          { "text": "info", "value": "info", "selected": false },
          { "text": "warning", "value": "warning", "selected": false },
          { "text": "error", "value": "error", "selected": false },
          { "text": "critical", "value": "critical", "selected": false }
        ]
      },
      {
        "name": "request_id",
        "label": "request_id",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      },
      {
        "name": "search",
        "label": "搜尋文字",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "每分鐘 log 數（依 service）",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({service=~\"$service\", level=~\"$level\"} |~ \"(?i)$search\" [1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 12, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "error / critical（依 service）",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({service=~\"$service\", level=~\"error|critical|alert|emergency\"} [1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 1, "drawStyle": "bars" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "所有 log（篩選：service / level / request_id / 搜尋文字）",
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\", level=~\"$level\"} | request_id=~\"$request_id.*\" |~ \"(?i)$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "HTTP 5xx（api / web）",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"api|web\"} | event=\"http.response\" | json | context_status >= 500 | line_format \"{{.context_method}} {{.context_path}} → {{.context_status}} ({{.context_duration_ms}}ms) req={{.request_id}}\"",
          "queryType": "range"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels", "format": "json", "replace": false } },
        { "id": "organize", "options": { "excludeByName": { "labels": true, "id": true, "tsNs": true }, "indexByName": { "Time": 0, "service": 1, "request_id": 2, "Line": 3 } } }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "id": 5,
      "type": "table",
      "title": "慢請求 > 1000ms（http.response）",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"api|web\"} | event=\"http.response\" | json | context_duration_ms > 1000 | line_format \"{{.context_method}} {{.context_path}} {{.context_status}} {{.context_duration_ms}}ms req={{.request_id}}\"",
          "queryType": "range"
        }
      ],
      "transformations": [
        { "id": "extractFields", "options": { "source": "labels", "format": "json", "replace": false } },
        { "id": "organize", "options": { "excludeByName": { "labels": true, "id": true, "tsNs": true }, "indexByName": { "Time": 0, "service": 1, "request_id": 2, "Line": 3 } } }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "對外呼叫 http.outbound（Google、S3、SSR → api）",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"api|worker|web\"} | event=\"http.outbound\" | json | line_format \"[{{.context_client}}] {{.context_method}} {{.context_host}}{{.context_path}} → {{.context_status}} {{.context_duration_ms}}ms {{.context_error}}\"",
          "queryType": "range"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "例外與失敗任務（exception / job.failed / client.*）",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"$service\"} | event=~\"exception|job.failed|client.*\" | json | line_format \"[{{.service}}] {{.exception_class}}: {{.message}} @ {{.exception_file}}:{{.exception_line}} req={{.request_id}}\"",
          "queryType": "range"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" }
    }
  ]
}

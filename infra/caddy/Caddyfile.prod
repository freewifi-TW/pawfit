# 正式環境 Caddyfile：自動 HTTPS（Let's Encrypt）
# 以環境變數 SITE_DOMAIN 帶入網域，例如 pawfit.app
#
# Logging 與開發環境相同：X-Request-Id 貫穿三層、JSON access log 到 stdout 交給 Alloy。
# （不再寫 /data/access.log；容器 stdout 由 Docker json-file 限制大小，Loki 保留 30 天）

(request_id) {
	header_up X-Request-Id {http.request.uuid}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		>X-Request-Id {http.request.uuid}
	}

	# 嵌入（SASD Phase 1 FR-7.4 / FR-7.7）：只有 /embed/* 可被跨站 iframe（不送 X-Frame-Options）；
	# 其餘路由 frame-ancestors 'self' + X-Frame-Options SAMEORIGIN；公開頁與公開 API 帶 noai / noimageai
	@embed path /embed/*
	header @embed {
		Content-Security-Policy "frame-ancestors *"
		# 嵌入頁不設 cookie（i18n 的語言 cookie 也不要）
		-Set-Cookie
	}
	@notembed not path /embed/*
	header @notembed {
		Content-Security-Policy "frame-ancestors 'self'"
		X-Frame-Options SAMEORIGIN
	}
	# （/api/v1/public/* 與 /api/oembed 由 Laravel 的 PublicApiHeaders 自己帶，這裡不重複）
	@noai path /s/* /u/* /embed/*
	header @noai X-Robots-Tag "noai, noimageai"

	@api path /api/* /sanctum/* /up
	handle @api {
		reverse_proxy api:8080 {
			import request_id
		}
	}

	handle {
		reverse_proxy web:3000 {
			import request_id
		}
	}

	log {
		output stdout
		format json {
			time_format rfc3339_nano
			time_key ts
			level_key level
			message_key message
		}
	}
}

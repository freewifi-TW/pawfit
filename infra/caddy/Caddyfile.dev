# 開發用 Caddyfile：純 HTTP，:80 對外
# /api/* 與 /sanctum/* → Laravel；其餘 → Nuxt dev server（含 HMR websocket）
#
# Logging：
# - 每個請求產生 X-Request-Id（uuid），往後傳給 web / api，也回給瀏覽器
# - access log 以 JSON 輸出到 stdout，由 Alloy 收進 Loki（見 infra/observability）

(request_id) {
	header_up X-Request-Id {http.request.uuid}
}

:80 {
	encode zstd gzip

	header >X-Request-Id {http.request.uuid}

	# 嵌入（SASD Phase 1 FR-7.4 / FR-7.7）：只有 /embed/* 可被跨站 iframe；
	# 分享頁、個人主頁、嵌入與公開 API 一律帶 noai / noimageai
	@embed path /embed/*
	header @embed {
		Content-Security-Policy "frame-ancestors *"
		# 嵌入頁不設 cookie（i18n 的語言 cookie 也不要）
		-Set-Cookie
	}
	@notembed not path /embed/*
	header @notembed Content-Security-Policy "frame-ancestors 'self'"
	# （/api/v1/public/* 與 /api/oembed 由 Laravel 的 PublicApiHeaders 自己帶，這裡不重複）
	@noai path /s/* /u/* /embed/*
	header @noai X-Robots-Tag "noai, noimageai"

	@api path /api/* /sanctum/* /up
	handle @api {
		reverse_proxy api:8080 {
			import request_id
		}
	}

	handle {
		reverse_proxy web:3000 {
			import request_id
		}
	}

	log {
		output stdout
		format json {
			time_format rfc3339_nano
			time_key ts
			level_key level
			message_key message
		}
	}
}

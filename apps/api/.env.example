APP_NAME=Pawfit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_TW

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pawfit
DB_USERNAME=pawfit
DB_PASSWORD=pawfit

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=pawfit
AWS_SECRET_ACCESS_KEY=pawfitpawfit
AWS_DEFAULT_REGION=auto
AWS_BUCKET=pawfit-media
AWS_USE_PATH_STYLE_ENDPOINT=true
# 開發用 MinIO：容器與瀏覽器都能解析 host.docker.internal，簽名 URL 才能在兩邊通用（正式改 R2 endpoint）
AWS_ENDPOINT=http://host.docker.internal:9000
AWS_URL=http://host.docker.internal:9000/pawfit-media

# Sanctum same-domain cookie auth（經 Caddy :8080）
SANCTUM_STATEFUL_DOMAINS=localhost:8080

VITE_APP_NAME="${APP_NAME}"

# ---- Pawfit ----
FRONTEND_URL=http://localhost:8080
# 管理員 email 名單（逗號分隔）
ADMIN_EMAILS=
# 本機沒有 Google 憑證時，允許 POST /api/auth/dev-login 直接登入（僅 APP_ENV=local 生效）
FEATURE_DEV_LOGIN=true
# Google OAuth（GCP Console → 憑證 → OAuth 2.0 用戶端；已授權的重新導向 URI 填 ${APP_URL}/api/auth/google/callback）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# 統一 log 格式的 service 欄位（compose 會覆蓋：api / worker）；格式見 docs/logging.md
LOG_SERVICE=api
